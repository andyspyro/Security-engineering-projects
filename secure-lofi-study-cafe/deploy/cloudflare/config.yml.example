# Optional public-ingress pattern that keeps inbound router ports closed.
# Replace the UUID, credential path, and hostname with values from your
# Cloudflare Tunnel configuration.

tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json

ingress:
  - hostname: cafe.example.com
    service: http://127.0.0.1:3000
  - service: http_status:404
