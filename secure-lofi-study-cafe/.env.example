# Runtime
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Browser origin allowed to establish authenticated realtime connections.
# Use the exact public origin when deployed, for example:
# PUBLIC_ORIGIN=https://cafe.example.com
PUBLIC_ORIGIN=
ALLOWED_ORIGINS=

# Set true only when requests arrive through a trusted local reverse proxy
# such as Caddy or cloudflared on the same server.
TRUST_PROXY=true

# Public HTTPS deployments: true
# Controlled LAN-only HTTP testing: false
COOKIE_SECURE=true

# Persistent SQLite database location.
DB_PATH=/var/lib/secure-lofi-study-cafe/lofi_cafe.db

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Permanent administrator provisioned server-side.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password
