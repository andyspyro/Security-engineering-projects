PORT=3000
HOST=127.0.0.1

# Set true only when requests arrive through a trusted local reverse proxy
# such as Caddy or cloudflared on the same server.
TRUST_PROXY=true

# Set true when the browser reaches the application over HTTPS.
# For LAN-only HTTP testing, set false.
COOKIE_SECURE=true

SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=production

# Self-hosted SQLite database. The systemd service grants write access here.
DB_PATH=/var/lib/secure-lofi-study-cafe/lofi_cafe.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password
