<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Secure Lo-Fi Study Cafe</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body
  data-csrf="<%= csrfToken %>"
  data-user-id="<%= currentUserId %>"
  data-can-moderate="<%= canModerate %>"
  data-can-assign="<%= canAssignTempAdmin %>"
>
  <header class="topbar">
    <div>
      <p class="eyebrow">Secure Study Room</p>
      <h1>Secure Lo-Fi Study Café</h1>
      <p class="session-line">Logged in as <strong><%= user.username %></strong> &nbsp;|&nbsp; Role: <strong><%= user.role %></strong></p>
    </div>

    <div class="topbar-actions">
      <% if (canAssignTempAdmin) { %>
        <a class="button primary small" href="/admin">Admin Console</a>
      <% } %>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="button secondary small" type="submit">Logout</button>
      </form>
    </div>
  </header>

  <main class="cafe-grid">
    <div class="player-column">
      <section class="panel">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">Shared Player</p>
            <h2>Lo-Fi Study Music</h2>
          </div>
          <span id="controller-badge" class="badge">Synced Room</span>
        </div>

        <div class="player-meta">
          <div>Room Track: <strong id="now-playing-title">Not playing</strong></div>
          <div id="requested-by-line">Requested by —</div>
          <div id="controller-line">Room controller: waiting for room state.</div>
          <div id="player-status" class="controller-message">Syncing with the room controller…</div>
        </div>

        <div id="player" class="player-frame" aria-label="Shared YouTube player"></div>

        <div class="player-actions">
          <button id="sync-button" class="button primary" type="button">Sync to Controller</button>
          <button id="independent-button" class="button secondary" type="button">Listen Independently</button>
          <button id="vote-button" class="button secondary" type="button">Vote Next</button>

          <% if (canModerate) { %>
            <form method="post" action="/admin/player/next">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="button secondary" type="submit">Admin Play Next</button>
            </form>
          <% } %>
        </div>

        <p class="compact">Vote next: <span id="vote-count">0/1</span> needed. Members online: <span id="inline-member-count">0</span>.</p>
        <p class="compact">If the browser pauses while you switch apps, the room will automatically sync back when you return.</p>

        <div class="section-rule"></div>

        <h3>Shared Playlist</h3>
        <p class="compact">Everyone sees this queue. Admin/mod can rearrange it.</p>
        <div id="queue-list" class="list-stack">
          <p class="muted">Queue is loading…</p>
        </div>

        <div class="section-rule"></div>

        <h3>Request Music</h3>
        <p class="compact">Paste a YouTube video link. An admin must approve it before it plays.</p>
        <form method="post" action="/music-requests" class="request-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <label>
            Track title
            <input name="title" maxlength="100" placeholder="Track title" required>
          </label>

          <label>
            YouTube URL or embed
            <input name="url" maxlength="1500" placeholder="https://www.youtube.com/watch?v=…" required>
          </label>

          <div>
            <button class="button primary" type="submit">Request Song</button>
          </div>
        </form>

        <div class="section-rule"></div>

        <details>
          <summary>Last Played</summary>
          <div id="history-list" class="list-stack" style="margin-top:.8rem">
            <p class="muted">History is loading…</p>
          </div>
        </details>

        <% if (canModerate) { %>
          <div class="section-rule"></div>
          <details open>
            <summary>Pending Music Requests</summary>
            <div id="pending-list" class="list-stack" style="margin-top:.8rem">
              <p class="muted">Pending requests are loading…</p>
            </div>
          </details>
        <% } %>
      </section>
    </div>

    <div class="chat-column">
      <section class="panel">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">Live Room</p>
            <h2>Study Chat</h2>
          </div>

          <div class="chat-toolbar">
            <span id="socket-status" class="badge live">Connecting</span>
            <button id="minimize-chat" class="button secondary small" type="button">Minimize Chat</button>
          </div>
        </div>

        <div id="chat-body" class="chat-body">
          <div class="section-rule"></div>

          <section class="member-section">
            <h3>Members in Room</h3>
            <div id="members-list" class="list-stack">
              <p class="muted">Loading members…</p>
            </div>
            <span id="member-count" class="sr-only">0 online</span>
          </section>

          <form id="chat-form" class="chat-form">
            <label class="sr-only" for="chat-input">Study message</label>
            <input id="chat-input" maxlength="500" autocomplete="off" placeholder="Type a study message…" required>
            <button class="button primary" type="submit">Send</button>
          </form>

          <p class="compact">Regular-user messages are censored in the live room. For moderation and accountability, submitted chat text and application activity may be retained in the permanent-admin audit log.</p>

          <div id="chat-log" class="chat-log" aria-live="polite" style="margin-top:1rem">
            <% [...messages].reverse().forEach((message) => { %>
              <article class="message" data-message-id="<%= message.id %>">
                <div class="message-meta">
                  <strong><%= message.username %></strong>
                  <span><%= new Date(message.created_at).toLocaleString() %></span>
                </div>

                <p><%= message.message_text %></p>

                <% if (canModerate) { %>
                  <form method="post" action="/admin/messages/<%= message.id %>/delete" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="button danger" type="submit">Delete</button>
                  </form>
                <% } %>
              </article>
            <% }) %>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script src="/socket.io/socket.io.js"></script>
  <script src="https://www.youtube.com/iframe_api"></script>
  <script src="/cafe.js"></script>
</body>
</html>
