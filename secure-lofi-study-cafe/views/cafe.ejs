<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Study Cafe | Secure Lo-Fi Study Cafe</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body
  class="cafe-page"
  data-csrf="<%= csrfToken %>"
  data-user-id="<%= currentUserId %>"
  data-can-moderate="<%= canModerate %>"
  data-can-assign="<%= canAssignTempAdmin %>"
>
  <header class="topbar">
    <div>
      <p class="eyebrow">Secure Lo-Fi Study Cafe</p>
      <h1>Focus room</h1>
    </div>
    <div class="user-chip">
      <span class="presence-dot" aria-hidden="true"></span>
      <span><strong><%= user.username %></strong> · <%= user.role %></span>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="button ghost small" type="submit">Log out</button>
      </form>
    </div>
  </header>

  <main class="dashboard">
    <section class="panel player-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Room audio</p>
          <h2 id="now-playing-title">Not playing</h2>
        </div>
        <span id="controller-badge" class="badge">No controller</span>
      </div>
      <div id="player" class="player-frame" aria-label="Shared YouTube player"></div>
      <div class="player-actions">
        <button id="sync-button" class="button primary" type="button">Sync with room</button>
        <button id="independent-button" class="button secondary" type="button">Listen independently</button>
        <button id="vote-button" class="button secondary" type="button">Vote next <span id="vote-count">0/1</span></button>
        <% if (canModerate) { %>
          <form method="post" action="/admin/player/next">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="button danger" type="submit">Moderator next</button>
          </form>
        <% } %>
      </div>
      <p id="player-status" class="muted compact">Waiting for room state…</p>
    </section>

    <section class="panel request-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Music request</p>
          <h2>Add something to study to</h2>
        </div>
      </div>
      <form method="post" action="/music-requests" class="stack-form compact-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Track title
          <input name="title" maxlength="100" placeholder="Late night coding mix" required>
        </label>
        <label>YouTube link
          <input name="url" maxlength="1500" placeholder="https://www.youtube.com/watch?v=…" required>
        </label>
        <button class="button primary" type="submit">Submit request</button>
      </form>
      <p class="security-note">The server parses and validates YouTube IDs instead of trusting arbitrary embed HTML.</p>
    </section>

    <section class="panel chat-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Live chat</p>
          <h2>Study room</h2>
        </div>
        <span id="socket-status" class="badge">Connecting</span>
      </div>
      <div id="chat-log" class="chat-log" aria-live="polite">
        <% [...messages].reverse().forEach((message) => { %>
          <article class="message" data-message-id="<%= message.id %>">
            <div class="message-meta">
              <strong><%= message.username %></strong>
              <span><%= new Date(message.created_at).toLocaleString() %></span>
            </div>
            <p><%= message.message_text %></p>
            <% if (canModerate) { %>
              <form method="post" action="/admin/messages/<%= message.id %>/delete" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="text-button" type="submit">Delete</button>
              </form>
            <% } %>
          </article>
        <% }) %>
      </div>
      <form id="chat-form" class="chat-form">
        <label class="sr-only" for="chat-input">Message</label>
        <input id="chat-input" maxlength="500" autocomplete="off" placeholder="Share a study update…" required>
        <button class="button primary" type="submit">Send</button>
      </form>
    </section>

    <section class="panel members-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Presence</p>
          <h2>Online members</h2>
        </div>
        <span id="member-count" class="badge">0 online</span>
      </div>
      <div id="members-list" class="list-stack"><p class="muted">Loading members…</p></div>
    </section>

    <section class="panel queue-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Shared queue</p>
          <h2>Up next</h2>
        </div>
      </div>
      <div id="queue-list" class="list-stack"><p class="muted">Queue is loading…</p></div>
    </section>

    <section class="panel history-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Recent tracks</p>
          <h2>History</h2>
        </div>
      </div>
      <div id="history-list" class="list-stack"><p class="muted">History is loading…</p></div>
    </section>

    <% if (canModerate) { %>
      <section class="panel pending-panel">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">Moderation</p>
            <h2>Pending requests</h2>
          </div>
        </div>
        <div id="pending-list" class="list-stack"><p class="muted">Pending requests are loading…</p></div>
      </section>
    <% } %>
  </main>

  <script src="/socket.io/socket.io.js"></script>
  <script src="https://www.youtube.com/iframe_api"></script>
  <script src="/cafe.js"></script>
</body>
</html>
