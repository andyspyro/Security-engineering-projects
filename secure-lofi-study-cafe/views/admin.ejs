<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Console | Secure Lo-Fi Study Cafe</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-page">
  <header class="topbar">
    <div>
      <p class="eyebrow">Permanent Admin</p>
      <h1>Administration & Audit Console</h1>
      <p class="session-line">
        Signed in as <strong><%= user.username %></strong>.
        This page is restricted to the permanent admin role.
      </p>
    </div>

    <div class="topbar-actions">
      <a class="button secondary small" href="/cafe">Back to Café</a>
      <a class="button secondary small" href="/security">Security Engineering</a>
      <a class="button primary small" href="/admin/report.csv">Download CSV Report</a>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="button secondary small" type="submit">Logout</button>
      </form>
    </div>
  </header>

  <main class="admin-shell">
    <nav class="admin-command-bar" aria-label="Admin console sections">
      <a class="admin-command-link" href="#overview">Overview</a>
      <a class="admin-command-link" href="#connected-users">Connected Users</a>
      <a class="admin-command-link" href="#sessions">Sessions</a>
      <a class="admin-command-link" href="#realtime">Realtime</a>
      <a class="admin-command-link" href="#moderation">Moderation</a>
      <a class="admin-command-link" href="#music-requests">Music Requests</a>
      <a class="admin-command-link" href="#audit-log">Audit Log</a>
      <a class="admin-command-link" href="#security-events">Security Events</a>
      <a class="admin-command-link" href="#system">System</a>
    </nav>

    <section id="overview" class="admin-stat-grid admin-anchor" aria-label="Audit summary">
      <article class="admin-stat">
        <span>Users</span>
        <strong><%= counts.users %></strong>
      </article>
      <article class="admin-stat">
        <span>Online now</span>
        <strong><%= counts.onlineUsers %></strong>
      </article>
      <article class="admin-stat">
        <span>Live sockets</span>
        <strong><%= counts.activeSockets %></strong>
      </article>
      <article class="admin-stat">
        <span>Active sessions</span>
        <strong><%= counts.activeSessions %></strong>
      </article>
      <article class="admin-stat">
        <span>Failed logins · 24h</span>
        <strong><%= counts.failedLogins24h %></strong>
      </article>
      <article class="admin-stat">
        <span>Audit events</span>
        <strong><%= counts.auditEvents %></strong>
      </article>
      <article class="admin-stat">
        <span>Security events</span>
        <strong><%= counts.securityEvents %></strong>
      </article>
      <article class="admin-stat">
        <span>High severity</span>
        <strong><%= counts.highSecurityEvents %></strong>
      </article>
      <article class="admin-stat">
        <span>Blocked / failed</span>
        <strong><%= counts.blockedSecurityEvents %></strong>
      </article>
      <article class="admin-stat">
        <span>Chat records</span>
        <strong><%= counts.messages %></strong>
      </article>
      <article class="admin-stat">
        <span>Deleted messages</span>
        <strong><%= counts.deletedMessages %></strong>
      </article>
      <article class="admin-stat">
        <span>Music requests</span>
        <strong><%= counts.musicRequests %></strong>
      </article>
    </section>

    <section class="panel admin-policy admin-anchor">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Privacy Boundary</p>
          <h2>What this admin can inspect</h2>
        </div>
      </div>
      <p>
        The console records activity generated inside this application: usernames, roles,
        account timestamps, chat content, moderation history, music requests, queue actions,
        authentication events, votes, privileged actions, client IP addresses, and browser
        user-agent strings needed for security investigation.
      </p>
      <p class="compact">
        It intentionally does not expose passwords or password hashes, raw session cookies,
        authentication tokens, browser history, precise geolocation, unrelated device data,
        or hidden device fingerprints. Session identifiers are represented only by a keyed,
        non-reversible correlation reference.
      </p>
    </section>

    <section id="session-security" class="panel admin-anchor">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Current Admin Request</p>
          <h2>Session & Cookie Security</h2>
        </div>
        <span class="badge live">safe metadata only</span>
      </div>

      <div class="admin-session-grid">
        <article class="admin-session-card">
          <p><strong>Client IP</strong></p>
          <code><%= requestContext.clientIp %></code>
          <p><strong>Session reference</strong></p>
          <code><%= requestContext.sessionRef %></code>
          <p class="admin-small">The raw session cookie value is never displayed.</p>
        </article>

        <article class="admin-session-card">
          <p><strong>Cookie</strong> <code><%= requestContext.cookie.name %></code></p>
          <p>HttpOnly: <strong><%= requestContext.cookie.httpOnly ? "yes" : "no" %></strong></p>
          <p>Secure: <strong><%= requestContext.cookie.secure ? "yes" : "no" %></strong></p>
          <p>SameSite: <strong><%= requestContext.cookie.sameSite %></strong></p>
          <p>Max age: <strong><%= requestContext.cookie.maxAgeMinutes %> minutes</strong></p>
          <p>Expires: <strong><%= requestContext.cookie.expiresAt || "session-managed" %></strong></p>
        </article>
      </div>

      <p class="admin-user-agent">
        <strong>User agent:</strong> <%= requestContext.userAgent %>
      </p>
    </section>

    <section id="system" class="panel admin-anchor">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Server Operations</p>
          <h2>Runtime Health</h2>
        </div>
        <span class="badge live">running</span>
      </div>

      <div class="admin-runtime-grid">
        <article class="admin-runtime-card"><span>Node</span><strong><%= runtime.nodeVersion %></strong></article>
        <article class="admin-runtime-card"><span>Uptime</span><strong><%= Math.floor(runtime.uptimeSeconds / 60) %> min</strong></article>
        <article class="admin-runtime-card"><span>Memory RSS</span><strong><%= runtime.rssMb %> MB</strong></article>
        <article class="admin-runtime-card"><span>SQLite journal</span><strong><%= runtime.journalMode %></strong></article>
        <article class="admin-runtime-card"><span>Listen address</span><code><%= runtime.host %>:<%= runtime.port %></code></article>
        <article class="admin-runtime-card"><span>Trusted proxy</span><strong><%= runtime.trustProxy ? "loopback only" : "disabled" %></strong></article>
        <article class="admin-runtime-card"><span>Public origin</span><code><%= runtime.publicOrigin %></code></article>
        <article class="admin-runtime-card"><span>Database</span><code><%= runtime.databasePath %></code></article>
        <article class="admin-runtime-card"><span>Process ID</span><strong><%= runtime.pid %></strong></article>
      </div>
    </section>

    <section class="panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Search</p>
          <h2>Filter the audit console</h2>
        </div>
      </div>
      <label class="admin-search-label" for="admin-search">
        Search usernames, event names, message text, actions, or music titles
        <input id="admin-search" type="search" placeholder="Search audit records…">
      </label>
    </section>

    <section id="connected-users" class="panel admin-section admin-anchor" data-admin-section>
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Accounts & Presence</p>
          <h2>User Directory</h2>
        </div>
        <span class="badge admin">permanent-admin view</span>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Role</th>
              <th>Presence</th>
              <th>Last seen</th>
              <th>Latest IP</th>
              <th>Client</th>
              <th>Registered</th>
              <th>Messages</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach((account) => { %>
              <tr data-admin-row>
                <td><strong><%= account.username %></strong></td>
                <td><%= account.role %></td>
                <td>
                  <% if (account.online) { %>
                    <span class="badge live">online</span>
                    <div class="admin-small"><%= account.connection_count %> socket<%= account.connection_count === 1 ? "" : "s" %></div>
                  <% } else { %>
                    <span class="badge">offline</span>
                  <% } %>
                </td>
                <td><%= account.last_seen_at || "—" %></td>
                <td><code><%= account.latest_ip || "—" %></code></td>
                <td class="admin-user-agent"><%= account.latest_user_agent || "—" %></td>
                <td><%= account.created_at %></td>
                <td><%= account.message_count %></td>
                <td>
                  <div class="list-actions">
                    <button
                      class="button secondary small admin-inspect-button"
                      type="button"
                      data-admin-inspect
                      data-user-id="<%= account.id %>"
                      data-username="<%= account.username %>"
                      data-role="<%= account.role %>"
                      data-online="<%= account.online ? "true" : "false" %>"
                      data-connections="<%= account.connection_count %>"
                      data-last-seen="<%= account.last_seen_at || "" %>"
                      data-ip="<%= account.latest_ip || "" %>"
                      data-user-agent="<%= account.latest_user_agent || "" %>"
                      data-created="<%= account.created_at %>"
                      data-messages="<%= account.message_count %>"
                    >Inspect</button>
                    <% if (account.id !== user.id) { %>
                      <form method="post" action="/admin/users/<%= account.id %>/revoke-sessions" data-confirm-revoke="<%= account.username %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="button danger small" type="submit">Revoke Sessions</button>
                      </form>
                    <% } else { %>
                      <span class="admin-small">current admin</span>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section id="sessions" class="panel admin-section admin-anchor" data-admin-section>
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Authenticated Sessions</p>
          <h2>Active Server Sessions</h2>
        </div>
        <span class="badge"><%= activeSessions.length %> active</span>
      </div>

      <p class="compact">
        Raw session IDs and raw cookies are never displayed. The reference below is an HMAC-derived
        correlation value that lets you connect session activity across security events without
        exposing the authentication credential.
      </p>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Role</th>
              <th>Session ref</th>
              <th>Updated</th>
              <th>Expires</th>
            </tr>
          </thead>
          <tbody>
            <% activeSessions.forEach((session) => { %>
              <tr data-admin-row>
                <td><strong><%= session.username %></strong></td>
                <td><%= session.role %></td>
                <td><code><%= session.sessionRef %></code></td>
                <td><%= session.updatedAt %></td>
                <td><%= new Date(session.expiresAt).toISOString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section id="realtime" class="panel admin-section admin-anchor" data-admin-section>
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Connection History</p>
          <h2>Realtime Presence Sessions</h2>
        </div>
        <span class="badge"><%= presenceHistory.length %> recent</span>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Role</th>
              <th>Room</th>
              <th>Status</th>
              <th>Socket ref</th>
              <th>Connected</th>
              <th>Last seen</th>
              <th>Disconnected</th>
            </tr>
          </thead>
          <tbody>
            <% presenceHistory.forEach((presence) => { %>
              <tr data-admin-row>
                <td><strong><%= presence.username %></strong></td>
                <td><%= presence.role %></td>
                <td><%= presence.room_name %></td>
                <td><span class="badge <%= presence.status === "online" ? "live" : "" %>"><%= presence.status %></span></td>
                <td><code><%= presence.socket_ref %></code></td>
                <td><%= presence.connected_at %></td>
                <td><%= presence.last_seen_at %></td>
                <td><%= presence.disconnected_at || "—" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section id="security-events" class="panel admin-section admin-anchor" data-admin-section>
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Security Telemetry</p>
          <h2>SQL Security Event Stream</h2>
        </div>
        <span class="badge"><%= securityEvents.length %> shown</span>
      </div>

      <p class="compact">
        Structured events are stored in the self-hosted SQLite database with indexed timestamps, event types,
        severity, outcome, actor, request ID, and a keyed session reference. Raw session
        tokens are never written to the log.
      </p>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Severity</th>
              <th>Outcome</th>
              <th>Actor</th>
              <th>Event</th>
              <th>HTTP / Route</th>
              <th>Request</th>
              <th>Session ref</th>
              <th>IP</th>
              <th>Client</th>
              <th>Metadata</th>
            </tr>
          </thead>
          <tbody>
            <% securityEvents.forEach((entry) => { %>
              <tr data-admin-row>
                <td><%= entry.created_at %></td>
                <td><span class="badge <%= entry.severity === "HIGH" ? "admin" : entry.severity === "WARNING" ? "user" : "live" %>"><%= entry.severity %></span></td>
                <td><%= entry.outcome %></td>
                <td><%= entry.actor_username || entry.username_snapshot || "anonymous" %></td>
                <td><code><%= entry.event_type %></code></td>
                <td><%= entry.http_method || "—" %> <%= entry.route || "—" %></td>
                <td><code><%= entry.request_id || "—" %></code></td>
                <td><code><%= entry.session_ref || "—" %></code></td>
                <td><code><%= entry.client_ip || "—" %></code></td>
                <td class="admin-user-agent"><%= entry.user_agent || "—" %></td>
                <td class="admin-details"><%= entry.metadata || "—" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section id="audit-log" class="panel admin-section admin-anchor" data-admin-section>
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Audit Trail</p>
          <h2>Security & Administrative Activity</h2>
        </div>
        <span class="badge"><%= auditLogs.length %> shown</span>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Actor</th>
              <th>Event</th>
              <th>Target</th>
              <th>Action</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody>
            <% auditLogs.forEach((entry) => { %>
              <tr data-admin-row>
                <td><%= entry.created_at %></td>
                <td><%= entry.actor_username || "system" %></td>
                <td><code><%= entry.event_type || "legacy" %></code></td>
                <td><%= entry.target_username || "—" %></td>
                <td><%= entry.action %></td>
                <td class="admin-details"><%= entry.details || "—" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section id="moderation" class="panel admin-section admin-anchor" data-admin-section>
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Communication & Moderation</p>
          <h2>Chat Message History</h2>
        </div>
        <span class="badge"><%= messageHistory.length %> shown</span>
      </div>

      <p class="compact">
        Moderated messages are soft-deleted from the live room but retained here so the
        permanent admin can reconstruct what happened and who performed the moderation.
      </p>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Author</th>
              <th>Role</th>
              <th>Message</th>
              <th>Status</th>
              <th>Deleted by</th>
            </tr>
          </thead>
          <tbody>
            <% messageHistory.forEach((message) => { %>
              <tr data-admin-row>
                <td><%= message.created_at %></td>
                <td><strong><%= message.author_username %></strong></td>
                <td><%= message.author_role %></td>
                <td class="admin-message"><%= message.message_text %></td>
                <td>
                  <% if (message.deleted_at) { %>
                    <span class="badge admin">deleted</span>
                    <div class="admin-small"><%= message.deleted_at %></div>
                  <% } else { %>
                    <span class="badge live">active</span>
                  <% } %>
                </td>
                <td><%= message.deleted_by_username || "—" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section id="music-requests" class="panel admin-section admin-anchor" data-admin-section>
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Media Workflow</p>
          <h2>Music Request History</h2>
        </div>
        <span class="badge"><%= musicRequests.length %> shown</span>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Time</th>
              <th>User</th>
              <th>Title</th>
              <th>YouTube ID</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% musicRequests.forEach((request) => { %>
              <tr data-admin-row>
                <td><%= request.created_at %></td>
                <td><strong><%= request.username %></strong></td>
                <td><%= request.title %></td>
                <td><code><%= request.video_id %></code></td>
                <td><%= request.status %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <dialog id="admin-user-inspector" class="admin-user-inspector">
    <form method="dialog" class="dialog-close-row">
      <button class="icon-button" value="close" aria-label="Close user inspector">×</button>
    </form>
    <div id="admin-user-inspector-content"></div>
  </dialog>

  <script src="/admin.js"></script>
</body>
</html>
