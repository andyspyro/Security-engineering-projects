<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in | Secure Lo-Fi Study Cafe</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-card" aria-labelledby="login-title">
      <div class="brand-mark" aria-hidden="true">♫</div>
      <p class="eyebrow">Secure study room</p>
      <h1 id="login-title">Welcome back</h1>
      <p class="muted">Sign in to the shared study cafe.</p>

      <% if (errors && errors.length) { %>
        <div class="alert" role="alert">
          <strong>Unable to sign in:</strong>
          <ul>
            <% errors.forEach((error) => { %><li><%= error %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <form method="post" action="/login" class="stack-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Username
          <input name="username" autocomplete="username" required>
        </label>
        <label>Password
          <input type="password" name="password" autocomplete="current-password" required>
        </label>
        <button class="button primary" type="submit">Sign in</button>
      </form>

      <p class="auth-switch">Need an account? <a href="/register">Create one</a></p>
      <p class="security-note">The server validates credentials, enforces rate limits, and keeps authentication state in the session.</p>
    </section>
  </main>
</body>
</html>
