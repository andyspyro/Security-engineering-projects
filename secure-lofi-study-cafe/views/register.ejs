<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Register | Secure Lo-Fi Study Cafe</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-card" aria-labelledby="register-title">
      <div class="coffee-mark auth-coffee-mark" aria-hidden="true">
        <span class="steam steam-one"></span>
        <span class="steam steam-two"></span>
        <span class="steam steam-three"></span>
        <span class="coffee-cup">☕</span>
      </div>
      <h1 id="register-title">Create Account</h1>
      <p class="auth-subtitle">Register to join your cozy study room.</p>

      <% if (errors && errors.length) { %>
        <div class="alert" role="alert">
          <% errors.forEach((error) => { %>
            <div><%= error %></div>
          <% }) %>
        </div>
      <% } %>

      <form method="post" action="/register" class="stack-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <label>
          Username
          <input name="username" autocomplete="username" minlength="3" maxlength="30" pattern="[A-Za-z0-9_]+" placeholder="Choose a username" required>
        </label>

        <label>
          Password
          <input type="password" name="password" autocomplete="new-password" minlength="12" maxlength="200" placeholder="At least 12 characters" required>
        </label>

        <div>
          <button class="button primary" type="submit">Register</button>
        </div>

        <p class="auth-switch">Already have an account? <a href="/login">Log In</a></p>
        <p class="security-note">For safety and moderation, the service records usernames, account activity, chat submissions, music requests, and administrative actions. It does not expose plaintext passwords, session tokens, precise location, browser history, or unrelated device data to administrators.</p>
      </form>
    </section>
  </main>
</body>
</html>
