<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Register | Secure Lo-Fi Study Cafe</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-card" aria-labelledby="register-title">
      <div class="cafe-icon" aria-hidden="true">☕</div>
      <h1 id="register-title">Create Account</h1>
      <p class="auth-subtitle">Register to join your cozy study room.</p>

      <% if (errors && errors.length) { %>
        <div class="alert" role="alert">
          <% errors.forEach((error) => { %>
            <div><%= error %></div>
          <% }) %>
        </div>
      <% } %>

      <form method="post" action="/register" class="stack-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <label>
          Username
          <input name="username" autocomplete="username" minlength="3" maxlength="30" pattern="[A-Za-z0-9_]+" placeholder="Choose a username" required>
        </label>

        <label>
          Password
          <input type="password" name="password" autocomplete="new-password" minlength="8" placeholder="At least 8 characters" required>
        </label>

        <div>
          <button class="button primary" type="submit">Register</button>
        </div>

        <p class="auth-switch">Already have an account? <a href="/login">Log In</a></p>
      </form>
    </section>
  </main>
</body>
</html>
